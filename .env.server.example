# Copy this file to `.env` or set these variables in your server environment.
# WARNING: keep your real key secret. This repository already ignores `.env`.

# Your Groq API key (server-side only)
GROQ_API_KEY=your_real_groq_api_key_here

# Optional: override default Groq model endpoint
GROQ_API_URL=https://api.groq.ai/v1/models/groq-1/outputs

# Port the proxy will listen on
PORT=3001
